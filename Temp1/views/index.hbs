<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Search any city and get its current weather." />
    <meta name="theme-color" content="#14122b" />
    <title>Weather App</title>
    <link rel="stylesheet" href="css/style.css" />
      <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%2314122b'/%3E%3Ccircle cx='12' cy='12' r='4.5' fill='%23ffb45e'/%3E%3Cg stroke='%23ffb45e' stroke-width='2' stroke-linecap='round'%3E%3Cpath d='M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4'/%3E%3C/g%3E%3C/svg%3E" />
</head>

<body>
    <!-- Wallpaper layers -->
    <!-- Kept empty so script.js can still find it; the real wallpaper is .wallpaper -->
    <div id="background" aria-hidden="true"></div>
    <div class="wallpaper" aria-hidden="true"></div>
    <video id="videoC" muted loop autoplay playsinline aria-hidden="true"></video>

    <header class="header">
        <a class="header__brand" href="./">
            <svg class="header__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <circle cx="12" cy="12" r="4.5" fill="currentColor" />
                <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
                </g>
            </svg>
            <span>Weather</span>
        </a>
    </header>

    <main class="card">
        <h1 class="card__title">What's the weather like?</h1>
        <p class="card__subtitle">Search for any city to see its forecast.</p>

        <form id="form1" class="search" role="search">
            <label for="address" class="visually-hidden">City name</label>
            <input
                type="text"
                id="address"
                class="search__input"
                placeholder="e.g. Cairo"
                autocomplete="off"
                required
            />
            <button type="submit" class="search__button">Search</button>
        </form>

        <section class="results" aria-live="polite">
            <p id="location" class="results__location"></p>
            <p id="forecast" class="results__forecast"></p>
            <p id="code" class="results__code"></p>
            <p id="error" class="results__error" role="alert"></p>
        </section>
    </main>

    <script src="js/script.js"></script>
</body>
</html>